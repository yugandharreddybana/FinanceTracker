# ============================================================
# FRONTEND (Vite) — deployed on Vercel
# ============================================================
# URL of the Node.js middleware/server (Railway)
VITE_MIDDLEWARE_URL=http://localhost:4001

# Optional Cursor/agent DELETE probes to local ingest — only when DEV and explicitly enabled.
VITE_AGENT_DEBUG=false

# DO NOT set VITE_API_URL — frontend never calls Spring Boot directly


# ============================================================
# NODE MIDDLEWARE (server/) — deployed on Railway
# ============================================================
PORT=4001
NODE_ENV=development

# Required: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-random-secret-here

# 32-byte hex (64 chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=your-64-char-hex-here

# NVIDIA NIM API key — get free at https://build.nvidia.com
# Model used: meta/llama-3.3-70b-instruct
# One line only — duplicate NVIDIA_API_KEY= in the same file is silently ignored except the LAST (rotation trap).
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Gemini — middleware / Railway ONLY (`server/`). Never add VITE_GEMINI_* (browser-exposed).
# Do not duplicate in `.env.local`; use this root `.env` for local middleware or platform secrets in prod.
# https://aistudio.google.com/app/apikey — revoke/regenerate immediately if one was ever pasted into git or Markdown.
GEMINI_API_KEY=your_gemini_api_key_here

# Alpha Vantage for live stock prices (optional — mock data used if not set)
# Free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Railway PostgreSQL (add PostgreSQL addon on Railway — DATABASE_URL auto-injected)
# REQUIRED in production. Local JSON fallback is dev-only.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Demo email skips verified-email gate — requires ALLOW_DEMO_EMAIL_VERIFICATION_BYPASS=true when NODE_ENV=production.
ALLOW_DEMO_EMAIL_VERIFICATION_BYPASS=false

# Seeded admin/demo accounts (created on Express startup — no Stripe required)
# demo@yugifinance.com (FREE tier, public Try Demo button — password server-side only)
# free@ / pro@ / enterprise@ / yugi@example.com — tier admins, password ADMIN_SEED_PASSWORD
ADMIN_SEED_PASSWORD=Test@1234
DEMO_PASSWORD=demo123456

# Finance proxy NDJSON / ingest debugging — NEVER enable in production.
DEBUG_PROXY=false

# Use production-like rate limits (finance + AI) when NODE_ENV is not production — e.g. staging.
STRICT_PROXY_RATE_LIMIT=false
STRICT_AI_RATE_LIMIT=false

# Redis (required in production for OTP store, rate-limit counters, idempotency cache)
REDIS_URL=redis://localhost:6379

# Email — SendGrid REST is wired in server/routes/auth.ts (SMTP_HOST alone is not enough yet).
# Production password reset requires SENDGRID_API_KEY + EMAIL_FROM together.
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Mock stock prices without Alpha Vantage: omit "random" for deterministic jitter per symbol.
INVESTMENT_MOCK_JITTER=

# Stripe billing (EUR + INR price IDs from Stripe Dashboard)
# Without STRIPE_SECRET_KEY in development, checkout/portal use a dev mock that syncs tier via SUBSCRIPTION_SYNC_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_EUR=price_...
STRIPE_PRICE_PRO_INR=price_...
STRIPE_PRICE_ENTERPRISE_EUR=price_...
STRIPE_PRICE_ENTERPRISE_INR=price_...
# Legacy fallbacks (EUR only)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
SUBSCRIPTION_SYNC_SECRET=your-shared-sync-secret

# Your deployed Vercel frontend URL (comma-separated for multiple). Local dev: http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Spring Boot backend URL (used by middleware only, never exposed to frontend)
JAVA_BACKEND_URL=http://localhost:8081

# Cookie domain — leave blank for localhost, set to your Railway domain in production
COOKIE_DOMAIN=


# ============================================================
# JAVA SPRING BOOT BACKEND (backend/) — deployed on Railway
# ============================================================
# Supabase PostgreSQL connection string
# Format: jdbc:postgresql://host:port/dbname?prepareThreshold=0
DB_URL=jdbc:postgresql://your-supabase-host:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password

# Hibernate + PostgreSQL: MUST stay validate — never update/create/create-drop (silent prod drift).
# HibernateSchemaGuard rejects dangerous ddl-auto against non-H2 JDBC. Schema changes → Flyway (db/migration/).
DDL_AUTO=validate

# CORS for Spring — middleware origin ONLY (comma-separated if needed). Separate from Node `ALLOWED_ORIGINS`.
JAVA_ALLOWED_ORIGINS=http://localhost:4001

# NDJSON agent diagnostics — default off (finance-tier prod hygiene).
FINANCE_TRACKER_AGENT_DEBUG=false
