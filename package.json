{
  "name": "finance-tracker",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "server"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "secrets:guard": "node scripts/secrets-git-guard.mjs",
    "secrets:scan": "node scripts/run-gitleaks-if-present.mjs",
    "env:lint": "node scripts/check-env-unique-keys.mjs",
    "git-hooks:install": "node scripts/install-git-hooks.mjs",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:server": "npm run dev -w server",
    "dev:backend": "cd backend && mvn spring-boot:run",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:full": "concurrently \"npm run dev:frontend\" \"npm run dev:server\" \"npm run dev:backend\"",
    "build:frontend": "npm run build -w packages/frontend",
    "build:server": "npm run build -w server",
    "build": "npm run build:frontend && npm run build:server",
    "start": "npm run start:middleware",
    "start:full": "npx concurrently \"npm run start:middleware\" \"npm run start:frontend\" \"java -jar backend/target/finance-tracker-backend-1.0.0.jar\"",
    "start:middleware": "npm --prefix server run start",
    "start:frontend": "npm --prefix packages/frontend run dev",
    "test": "npm test -w server && npm test -w packages/frontend",
    "test:backend": "cd backend && mvn -B test",
    "test:all": "npm test && npm run test:backend",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test e2e/landing-page.spec.ts e2e/login.spec.ts e2e/signup.spec.ts e2e/auth.spec.ts e2e/forgot-password.spec.ts --project=chromium",
    "test:e2e:comprehensive": "npx playwright test e2e/comprehensive --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^8.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
